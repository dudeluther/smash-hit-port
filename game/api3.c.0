typedef unsigned char u8;
typedef unsigned short u16;
typedef unsigned int u32;
typedef unsigned long long u64;
typedef long long i64;
typedef void *HANDLE;
typedef i64 (*WNDPROC)(HANDLE, u32, u64, i64);
typedef struct { u32 size, style; WNDPROC proc; int cls_extra, wnd_extra; HANDLE inst, icon, cursor, brush; const u16 *menu, *name; HANDLE small; } WNDCLASSEXW;
typedef struct { HANDLE hwnd; u32 msg; u64 wparam; i64 lparam; u32 time; int x, y; u32 priv; } MSG;

#define API __declspec(dllimport)
API HANDLE GetStdHandle(u32);
API int WriteFile(HANDLE, const void *, u32, u32 *, void *);
API void ExitProcess(u32);
API HANDLE CreateThread(void *, u64, u32 (*)(void *), void *, u32, u32 *);
API void Sleep(u32);
API u32 GetCurrentThreadId(void);
API HANDLE CreateEventW(void *, int, int, const u16 *);
API int SetEvent(HANDLE);
API u32 GetTickCount(void);
API u16 RegisterClassExW(const WNDCLASSEXW *);
API HANDLE CreateWindowExW(u32, const u16 *, const u16 *, u32, int, int, int, int, HANDLE, HANDLE, HANDLE, void *);
API int DestroyWindow(HANDLE);
API i64 DefWindowProcW(HANDLE, u32, u64, i64);
API i64 CallWindowProcW(WNDPROC, HANDLE, u32, u64, i64);
API i64 SetWindowLongPtrW(HANDLE, int, i64);
API i64 GetWindowLongPtrW(HANDLE, int);
API i64 SendMessageW(HANDLE, u32, u64, i64);
API int SetPropW(HANDLE, const u16 *, HANDLE);
API HANDLE GetPropW(HANDLE, const u16 *);
API HANDLE RemovePropW(HANDLE, const u16 *);
API u32 RegisterWindowMessageW(const u16 *);
API int GetMessageW(MSG *, HANDLE, u32, u32);
API int PeekMessageW(MSG *, HANDLE, u32, u32, u32);
API i64 DispatchMessageW(const MSG *);
API int PostThreadMessageW(u32, u32, u64, i64);
API u32 MsgWaitForMultipleObjects(u32, const HANDLE *, int, u32, u32);
API u64 SetTimer(HANDLE, u64, u32, void *);
API int KillTimer(HANDLE, u64);
API int wsprintfW(u16 *, const u16 *, ...);
API u16 **CommandLineToArgvW(const u16 *, int *);
API int StringFromGUID2(const void *, u16 *, int);
API u8 SystemFunction036(void *, u32);
API int BCryptGenRandom(HANDLE, u8 *, u32, u32);

static HANDLE out;
static char line[256];
static int pos, failed;

static void put(const char *s) { while (*s && pos < 250) line[pos++] = *s++; }
static void num(u64 v) { char t[24]; int n = 0; do { t[n++] = (char)('0' + v % 10); v /= 10; } while (v); while (n) line[pos++] = t[--n]; }
static void flush(void) { u32 w; line[pos++] = '\n'; WriteFile(out, line, (u32)pos, &w, 0); pos = 0; }
static void check(const char *name, int ok, u64 got) {
    put(name); put(ok ? " ok" : " FAIL ");
    if (!ok) { num(got); failed++; }
    flush();
}
static int weq(const u16 *a, const char *b) { while (*b) if (*a++ != (u16)(u8)*b++) return 0; return *a == 0; }

static int timers, base_calls, sub_calls;
static i64 base_proc(HANDLE h, u32 msg, u64 wp, i64 lp) {
    if (msg == 0x113) { timers++; return 0; }
    if (msg == 0x8001) { base_calls++; return 77; }
    return DefWindowProcW(h, msg, wp, lp);
}
static WNDPROC old_proc;
static i64 sub_proc(HANDLE h, u32 msg, u64 wp, i64 lp) {
    if (msg == 0x8001) sub_calls++;
    return CallWindowProcW(old_proc, h, msg, wp, lp);
}
static u32 main_thread;
static u32 poster(void *arg) { Sleep(20); PostThreadMessageW(main_thread, 0x8002, 5, 6); return (u32)(u64)arg; }
static void *volatile entry_points[] = { (void *)base_proc, (void *)sub_proc, (void *)poster };
static int periodic(const u8 *b, int n, int period) { for (int i = period; i < n; i++) if (b[i] != b[i - period]) return 0; return 1; }

void start(void) {
    static u16 text[128];
    static u8 rnd[64], rnd2[64];
    static u16 names[70][8];
    out = GetStdHandle((u32)-11);
    main_thread = GetCurrentThreadId();

    WNDCLASSEXW wc = { sizeof wc, 0, base_proc, 0, 16, 0, 0, 0, 0, 0, L"rexcomp_api3", 0 };
    check("register a class", RegisterClassExW(&wc) != 0, 0);
    HANDLE w = CreateWindowExW(0, L"rexcomp_api3", L"t", 0, 0, 0, 50, 50, 0, 0, 0, 0);
    check("create a window", w != 0, 0);

    check("window procedure is the class procedure", (WNDPROC)GetWindowLongPtrW(w, -4) == base_proc, 0);
    old_proc = (WNDPROC)SetWindowLongPtrW(w, -4, (i64)entry_points[1]);
    check("subclassing returns the old procedure", old_proc == base_proc, 0);
    check("a subclassed message reaches both procedures", SendMessageW(w, 0x8001, 0, 0) == 77 && sub_calls == 1 && base_calls == 1, (u64)base_calls);
    SetWindowLongPtrW(w, -4, (i64)base_proc);
    check("window extra bytes start at zero", GetWindowLongPtrW(w, 0) == 0 && GetWindowLongPtrW(w, 8) == 0, 0);
    SetWindowLongPtrW(w, 0, 0x1122334455667788ll); SetWindowLongPtrW(w, 8, -5);
    check("window extra bytes keep their values", GetWindowLongPtrW(w, 0) == 0x1122334455667788ll && GetWindowLongPtrW(w, 8) == -5, 0);
    check("user data", SetWindowLongPtrW(w, -21, 99) == 0 && GetWindowLongPtrW(w, -21) == 99, 0);

    check("no property yet", GetPropW(w, L"thing") == 0, 0);
    check("set a property", SetPropW(w, L"thing", (HANDLE)0xABCD) != 0, 0);
    check("get a property, any case", GetPropW(w, L"THING") == (HANDLE)0xABCD, 0);
    SetPropW(w, L"other", (HANDLE)7);
    check("two properties", GetPropW(w, L"other") == (HANDLE)7 && GetPropW(w, L"thing") == (HANDLE)0xABCD, 0);
    check("remove a property", RemovePropW(w, L"thing") == (HANDLE)0xABCD && GetPropW(w, L"thing") == 0, 0);

    static u16 copy[] = L"rexcomp message one";
    u32 m1 = RegisterWindowMessageW(L"rexcomp message one"), m2 = RegisterWindowMessageW(L"rexcomp message two");
    check("registered messages are in range", m1 >= 0xC000 && m1 <= 0xFFFF && m2 >= 0xC000 && m2 <= 0xFFFF, m1);
    check("different names get different messages", m1 != m2, m2);
    check("the same name gets the same message", RegisterWindowMessageW(copy) == m1, 0);

    MSG msg;
    HANDLE ev = CreateEventW(0, 1, 0, 0);
    check("wait with nothing pending times out", MsgWaitForMultipleObjects(1, &ev, 0, 20, 0x4FF) == 258, 0);
    SetEvent(ev);
    check("wait reports a signalled handle", MsgWaitForMultipleObjects(1, &ev, 0, 1000, 0x4FF) == 0, 0);
    HANDLE never = CreateEventW(0, 1, 0, 0);
    PostThreadMessageW(main_thread, 0x8003, 1, 2);
    check("wait reports a posted message", MsgWaitForMultipleObjects(1, &never, 0, 1000, 0x4FF) == 1, 0);
    check("the posted message is there", PeekMessageW(&msg, 0, 0, 0, 1) && msg.msg == 0x8003 && msg.wparam == 1 && msg.lparam == 2, msg.msg);

    CreateThread(0, 0, (u32 (*)(void *))entry_points[2], 0, 0, 0);
    int got = GetMessageW(&msg, 0, 0, 0);
    check("GetMessage lets another thread post", got == 1 && msg.msg == 0x8002 && msg.wparam == 5 && msg.lparam == 6, msg.msg);

    check("set a timer", SetTimer(w, 42, 20, 0) == 42, 0);
    u32 t0 = GetTickCount();
    while (timers < 3 && GetTickCount() - t0 < 3000) { if (GetMessageW(&msg, 0, 0, 0) > 0) { if (msg.msg == 0x113 && msg.wparam != 42) failed++; DispatchMessageW(&msg); } }
    check("the timer fires", timers >= 3, (u64)timers);
    check("kill the timer", KillTimer(w, 42) != 0 && KillTimer(w, 42) == 0, 0);
    timers = 0; Sleep(80);
    while (PeekMessageW(&msg, 0, 0, 0, 1)) DispatchMessageW(&msg);
    check("a killed timer stays quiet", timers == 0, (u64)timers);

    int n = wsprintfW(text, L"%d|%5u|%-4d|%04x|%X|%s|%S|%c|%%|%I64d|%hs", -12, 34u, 5, 0xABu, 0xBEEFu, L"wide", "narrow", 'z', -9000000000ll, "h");
    check("wsprintfW", n == 54 && weq(text, "-12|   34|5   |00ab|BEEF|wide|narrow|z|%|-9000000000|h"), (u64)n);
    n = wsprintfW(text, L"[%3s][%.2s][%p]", L"a", L"xyz", (void *)0x1234);
    check("wsprintfW widths", weq(text, "[  a][xy][0000000000001234]"), (u64)n);

    int argc = 0;
    u16 **argv = CommandLineToArgvW(L"\"C:\\Program Files\\game.exe\" -a  \"two words\" c\\\\d \"e\\\"f\" g\\\\\\\"h \"\"", &argc);
    check("command line splits", argc == 7, (u64)argc);
    check("program name", argc > 0 && weq(argv[0], "C:\\Program Files\\game.exe"), 0);
    check("plain and quoted arguments", argc > 2 && weq(argv[1], "-a") && weq(argv[2], "two words"), 0);
    check("backslashes away from quotes stay", argc > 3 && weq(argv[3], "c\\\\d"), 0);
    check("escaped quotes", argc > 5 && weq(argv[4], "e\"f") && weq(argv[5], "g\\\"h"), 0);
    check("empty argument", argc > 6 && argv[6][0] == 0, 0);

    static const u8 guid[16] = { 0x67, 0x45, 0x23, 0x01, 0xAB, 0x89, 0xEF, 0xCD, 0x01, 0x23, 0x45, 0x67, 0x89, 0xAB, 0xCD, 0xEF };
    n = StringFromGUID2(guid, text, 64);
    check("guid to string", n == 39 && weq(text, "{01234567-89AB-CDEF-0123-456789ABCDEF}"), (u64)n);
    check("guid to string with a small buffer", StringFromGUID2(guid, text, 38) == 0, 0);

    check("random bytes", SystemFunction036(rnd, 64) != 0 && SystemFunction036(rnd2, 64) != 0, 0);
    int same = 0; for (int i = 0; i < 64; i++) same += rnd[i] == rnd2[i];
    check("random bytes do not repeat every four", !periodic(rnd, 64, 4) && !periodic(rnd, 64, 8) && !periodic(rnd, 64, 1), 0);
    check("two requests differ", same < 16, (u64)same);
    check("bcrypt random bytes", BCryptGenRandom(0, rnd2, 64, 2) == 0 && !periodic(rnd2, 64, 4), 0);

    int classes = 1;
    for (int i = 0; i < 70; i++) {
        names[i][0] = 'k'; names[i][1] = (u16)('a' + i / 26); names[i][2] = (u16)('a' + i % 26); names[i][3] = 0;
        wc.name = names[i];
        if (RegisterClassExW(&wc)) classes++;
    }
    check("registering many classes is safe", classes >= 64, (u64)classes);
    check("the window still works", GetWindowLongPtrW(w, -21) == 99 && DestroyWindow(w) != 0, 0);

    put(failed ? "FAILED " : "all passed"); if (failed) num((u64)failed); flush();
    ExitProcess((u32)failed);
}
