end

--
-- challenge
--

function challengeCompletedPopupCreate(centerX, centerY)
	local self = {}
	
	local challengeCompletedAspectMultiplier = math.min(mgGetAspectMultiplier(), 1.7543)
	
	self.canvas = mgCreateCanvas(1, 1)
	mgSetAlpha(self.canvas, 0)
	mgSetOrigo(self.canvas, "center")
	mgSetPos(self.canvas, centerX, centerY)
	mgSetScale(self.canvas, challengeCompletedAspectMultiplier, challengeCompletedAspectMultiplier)

	self.backplate = mgCreateImage("shared/popups/challenge/t_challenge_furthestdistance.png")
	mgSetOrigo(self.backplate, "center")
	mgSetPos(self.backplate, 0, 0)
	
	self.aspectMultiplier = challengeCompletedAspectMultiplier

	local buttonOffsetY = 200;
	
	self.btn_ok = mgCreateUi("shared/popups/challenge/challenge_complete_button.xml")
	mgSetOrigo(self.btn_ok, "center")
	mgSetPos(self.btn_ok, 0, buttonOffsetY)
	
	local titleTextOffsetY = -200
	local contentTextOffsetY = 0
	local textWidth = 1200

	self.titleTextOffsetY = titleTextOffsetY

	self.textTitleShadow = mgCreateUText("smash_light")
	mgSetColor(self.textTitleShadow, 0, 0, 0)
	mgSetOrigo(self.textTitleShadow, "center")
	mgSetPos(self.textTitleShadow, 3, titleTextOffsetY + 3)
	mgSetScale(self.textTitleShadow, 1.4, 1.4)
	
	self.textTitle = mgCreateUText("smash_light")
	mgSetColor(self.textTitle, 1, 1, 1)
	mgSetOrigo(self.textTitle, "center")
	mgSetPos(self.textTitle, 0, titleTextOffsetY)
	mgSetScale(self.textTitle, 1.4, 1.4)

	self.textWidth = textWidth
	self.contentTextOffsetY = contentTextOffsetY

	self.textContentShadow = mgCreateUText("smash_light")
	mgSetColor(self.textContentShadow, 0, 0, 0)
	mgSetOrigo(self.textContentShadow, "center")
	mgSetPos(self.textContentShadow, 3, contentTextOffsetY + 3)
	mgSetScale(self.textContentShadow, 0.9, 0.9)
	
	self.textContent = mgCreateUText("smash_light")
	mgSetColor(self.textContent, 0.31, 0.96, 0.996)
	mgSetOrigo(self.textContent, "center")
	mgSetPos(self.textContent, 0, contentTextOffsetY)
	mgSetScale(self.textContent, 0.9, 0.9)

	self.textButton = mgCreateUText("smash_light")
	mgSetColor(self.textButton, 1, 1, 1)
	mgSetUText(self.textButton, "popup_button_menu")
	mgSetOrigo(self.textButton, "center")
	mgSetPos(self.textButton, 0, buttonOffsetY + 10)

	return self
end


local function challengeCompletedPopupDraw(self)
	local alphaValue = mgGetAlpha(self.canvas)
	local is_visible = alphaValue > 0
	
	if is_visible then
		mgFullScreenColor(0, 0, 0, alphaValue * 0.5)
		mgPushCanvas(self.canvas)
		mgDraw(self.backplate)
		mgDraw(self.btn_ok)
		mgDraw(self.textTitleShadow)
		mgDraw(self.textTitle)
		mgDraw(self.textContentShadow)
		mgDraw(self.textContent)
		mgDraw(self.textButton)
		mgPopCanvas()
	end

	return is_visible
end


local function challengeCompletedPopupShow(self, uiScale)
	local challengeType = mgGet("game.challengeType")
	local challengeResultAmount = mgGet("game.challengeResultAmount")
	
	-- Set background image based on challenge type
	local backgroundImage = "shared/popups/challenge/t_challenge_furthestdistance.png"
	if challengeType == "balls" then
		backgroundImage = "shared/popups/challenge/t_challenge_ballscollected.png"
	elseif challengeType == "streak" then
		backgroundImage = "shared/popups/challenge/t_challenge_longeststreak.png"
	end
	mgSetImage(self.backplate, backgroundImage)
	
	-- Set title text
	local titleLocalizationKey = "popup_challenge_completed_title"
	mgSetUTextArea(self.textTitleShadow, titleLocalizationKey, self.textWidth, "center")
	mgSetUTextArea(self.textTitle, titleLocalizationKey, self.textWidth, "center")
	
	-- Set content text based on challenge type
	local contentLocalizationKey = "popup_challenge_completed_content_distance"
	if challengeType == "balls" then
		contentLocalizationKey = "popup_challenge_completed_content_balls"
	elseif challengeType == "streak" then
		contentLocalizationKey = "popup_challenge_completed_content_streak"
	end
	
	mgSetUTextArea(self.textContentShadow, contentLocalizationKey, self.textWidth, "center", "amount", challengeResultAmount)
	mgSetUTextArea(self.textContent, contentLocalizationKey, self.textWidth, "center", "amount", challengeResultAmount)
	
	mgSetAlpha(self.canvas, 0)
	mgSetScale(self.canvas, self.aspectMultiplier, 0.6 * self.aspectMultiplier)
	mgSetAlpha(self.canvas, 1, "easeout", 0.15)
	mgSetScale(self.canvas, self.aspectMultiplier, self.aspectMultiplier, "easeout", 0.15)
	mgSetUiModal(self.btn_ok, true)
end


local function challengeCompletedPopupHide(self)
	mgSetUiModal(self.btn_ok, false)

	mgSetAlpha(self.canvas, 0, "easein", 0.15)
	mgSetScale(self.canvas, 0.9 * self.aspectMultiplier, 0.7 * self.aspectMultiplier, "easein", 0.15)
	
end


local function challengeCompletedPopupIsVisible(self)
	return mgGetAlpha(self.canvas) > 0
end


function createChallengeCompletedPopup()
	return {create = challengeCompletedPopupCreate, draw = challengeCompletedPopupDraw, show = challengeCompletedPopupShow, hide = challengeCompletedPopupHide, is_visible = challengeCompletedPopupIsVisible}
end

